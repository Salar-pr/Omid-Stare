{
  "name": "omid-stare-server",
  "version": "1.0.0",
  "description": "OMID RASTAR PSYCH — Fastify + PostgreSQL + Drizzle lightweight modular monolith",
  "main": "src/server.js",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node scripts/migrate.js",
    "migrate:status": "node scripts/migrate.js --status",
    "seed": "node scripts/seed.js",
    "create-admin": "node scripts/create-admin.js",
    "setup": "npm run migrate && npm run seed",
    "db:embedded": "node scripts/db-embedded.js",
    "test": "node --test"
  },
  "dependencies": {
    "@fastify/compress": "^8.3.1",
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^8.1.1",
    "argon2": "^0.44.0",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.44.2",
    "fastify": "^5.3.2",
    "pg": "^8.16.3",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "embedded-postgres": "^16.14.0-beta.17",
    "pino-pretty": "^13.0.0"
  }
}
