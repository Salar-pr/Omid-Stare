# ============ OMID RASTAR — Backend env ============
# کپی کن:  cp .env.example .env   و مقادیر واقعی بگذار.
# هیچ‌وقت .env را commit نکن.

NODE_ENV=development
PORT=3000

# URL عمومی سایت (برای linkها و redirectها)
APP_URL=http://localhost:3000

# PostgreSQL — فقط از localhost/private network
DATABASE_URL=postgres://omid:omid@localhost:5432/omid_stare
DB_POOL_MAX=10

# Session / Auth
SESSION_TTL_DAYS=7
# secret برای امضای کوکی (در production یک مقدار تصادفی طولانی بگذار)
COOKIE_SECRET=
# اگر خالی باشد: production=true, development=false
COOKIE_SECURE=
# strict در production / lax در development (خودکار)

# Admin bootstrap (seed از اینا استفاده می‌کند)
ADMIN_EMAIL=admin@omid-stare.local
ADMIN_PASSWORD=ChangeMe_Strong_1405

# Notification channels: log,admin — بعداً telegram,email,sms
NOTIFICATION_CHANNELS=log,admin

# Media
UPLOAD_DIR=./uploads
MAX_AVATAR_BYTES=2097152
MAX_UPLOAD_BYTES=5242880

# فرانت‌اند استاتیک (default: ریشه repo)
FRONTEND_DIR=

# Shipping (تومان) — فعلاً ارسال رایگان
SHIPPING_AMOUNT=0

# Rate limit (دریافت هر 15 دقیقه، per IP)
RL_GLOBAL=300
RL_AUTH=10
RL_COUPON_CLAIM=8
RL_CONTACT=6
RL_ORDER=10

# Test database (برای npm test)
DATABASE_URL_TEST=postgres://omid:omid@localhost:5432/omid_stare_test

# ---------- امنیت ----------
# فقط اگر پشت reverse proxy هستی (nginx/Caddy/Cloudflare) مقدار بده.
# 1 = یک هاپ پراکسی | 10.0.0.0/8 = فقط این رنج | خالی = به هدر پراکسی اعتماد نکن
TRUST_PROXY=

# مبدأهای اضافی مجاز برای درخواست‌های تغییردهنده (بررسی CSRF)، جداشده با کاما
# APP_URL همیشه خودکار مجاز است.
CSRF_ALLOWED_ORIGINS=

# اجازه‌ی نمایش سایت داخل iframe یک دامنه‌ی دیگر (محیط پیش‌نمایش/دمو).
# خالی = خودکار (روشن در development، خاموش در production).
# در production فقط اگر واقعاً لازم است true کن — clickjacking را ممکن می‌کند.
# وقتی روشن است، روی HTTPS کوکی سشن SameSite=None; Secure می‌شود.
ALLOW_EMBEDDING=
